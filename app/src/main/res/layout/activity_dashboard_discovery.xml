<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4">

    <ScrollView
        android:id="@+id/discovery_setup_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仪表盘识别实验室"
                android:textColor="#202124"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stage 8F-P3 · Prototype 20260718-003"
                android:textColor="#6B625D"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFE4"
                android:padding="12dp"
                android:text="实验版暂不写入现有 Widget。AI 只识别一次；直接测试通过后，仅在本机保存最小字段规则和 Android Keystore 加密的网页登录状态。"
                android:textColor="#5B4200"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/discovery_saved_recipe_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#E8F5E9"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已保存的直连配方"
                    android:textColor="#1B5E20"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/discovery_saved_recipe_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#1B5E20"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/discovery_refresh_saved_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="不调用 AI，直接刷新" />

                <Button
                    android:id="@+id/discovery_delete_saved_recipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="删除这份配方" />
            </LinearLayout>

            <EditText
                android:id="@+id/discovery_api_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="模型 API Base，例如 https://example.com/v1"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/discovery_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="API Key（本次运行内存保存）"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:singleLine="true" />

            <EditText
                android:id="@+id/discovery_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="模型名称"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/discovery_dashboard_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="HTTPS 仪表盘网址"
                android:inputType="textUri"
                android:singleLine="true" />

            <CheckBox
                android:id="@+id/discovery_third_party_cookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="登录兼容模式：允许第三方 Cookie（仅登录循环时尝试）"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/discovery_setup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B3261E"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/discovery_open_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="打开仪表盘并登录" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="说明：部分平台禁止在嵌入式网页中登录；这种情况属于平台 OAuth 限制，不代表捕获逻辑失败。"
                android:textColor="#6B625D"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/discovery_browser_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/discovery_browser_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202124"
            android:ellipsize="middle"
            android:maxLines="2"
            android:padding="10dp"
            android:text="请登录并打开要识别的仪表盘页面"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/discovery_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <WebView
            android:id="@+id/discovery_web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/discovery_capture_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF4D6"
            android:padding="8dp"
            android:text="确认后页面会刷新一次。捕获到的 JSON 会先脱敏；点击 AI 识别即同意把脱敏候选数据发给当前模型接口。"
            android:textColor="#5B4200"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/discovery_confirm_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="确认当前页面并捕获" />

            <Button
                android:id="@+id/discovery_analyze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="调用一次 AI 识别" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/discovery_result_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="识别结果"
                android:textColor="#202124"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/discovery_result_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E8F5E9"
                android:padding="12dp"
                android:textColor="#1B5E20"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/discovery_result_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#202124"
                android:padding="12dp"
                android:textColor="#F1F3F4"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/discovery_recipe_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFF4D6"
                android:padding="10dp"
                android:textColor="#5B4200"
                android:textSize="13sp" />

            <Button
                android:id="@+id/discovery_save_recipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="直接测试并加密保存" />

            <Button
                android:id="@+id/discovery_back_to_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="返回仪表盘继续实验" />

            <Button
                android:id="@+id/discovery_restart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="清空本次捕获并重新开始" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
