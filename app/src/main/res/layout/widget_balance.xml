<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/bg_widget_card_dark">

    <!-- Row 1: Kimi + MiMo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Kimi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_platform_card_dark"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logo_kimi" />

                <TextView
                    android:id="@+id/kimi_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Kimi"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/kimi_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF34C759" />

            <TextView
                android:id="@+id/kimi_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#FF8E8E93" />

            <ProgressBar
                android:id="@+id/kimi_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_bar_green"
                android:progress="0"
                android:max="100" />

            <TextView
                android:id="@+id/kimi_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF34C759" />

            <TextView
                android:id="@+id/kimi_auxiliary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF8E8E93" />
        </LinearLayout>

        <!-- MiMo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_platform_card_dark"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logo_mimo" />

                <TextView
                    android:id="@+id/mimo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="MiMo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/mimo_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF8E8E93" />

            <TextView
                android:id="@+id/mimo_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#FF8E8E93" />

            <ProgressBar
                android:id="@+id/mimo_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_bar_blue"
                android:progress="0"
                android:max="100" />

            <TextView
                android:id="@+id/mimo_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF007AFF" />

            <TextView
                android:id="@+id/mimo_auxiliary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF8E8E93" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: DeepSeek + OpenAI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- DeepSeek -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_platform_card_dark"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logo_deepseek" />

                <TextView
                    android:id="@+id/ds_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="DeepSeek"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/ds_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF8E8E93" />

            <TextView
                android:id="@+id/ds_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#FF8E8E93" />

            <ProgressBar
                android:id="@+id/ds_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_bar_orange"
                android:progress="0"
                android:max="100" />

            <TextView
                android:id="@+id/ds_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FFFF9500" />

            <TextView
                android:id="@+id/ds_auxiliary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF8E8E93" />
        </LinearLayout>

        <!-- OpenAI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/bg_platform_card_dark"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logo_openai" />

                <TextView
                    android:id="@+id/oai_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="OpenAI"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/oai_tokens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF8E8E93" />

            <TextView
                android:id="@+id/oai_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#FF8E8E93" />

            <ProgressBar
                android:id="@+id/oai_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_bar_purple"
                android:progress="0"
                android:max="100" />

            <TextView
                android:id="@+id/oai_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FFAF52DE" />

            <TextView
                android:id="@+id/oai_auxiliary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="#FF8E8E93" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer: Update time + Click count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/update_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Updated: --:--:--"
            android:textSize="9sp"
            android:textColor="#FF8E8E93" />

        <TextView
            android:id="@+id/click_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#FF8E8E93" />
    </LinearLayout>

</LinearLayout>